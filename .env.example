# ============================================================
# 博客环境变量示例（复制为 .env 后填写）
# 部署平台：Vercel
# ============================================================

# ===== 数据库（必填）=====
# ★ DATABASE_URL：唯一必需变量，应用运行时 + 构建都靠它。
#   请用 Supabase **Transaction pooler（事务池，端口 6543）**：
#   serverless（Vercel 等）下多个函数实例 × 每实例连接池会抢占连接，
#   事务池由 Supavisor 把客户端连接复用为少量后端连接，不会打满 Postgres 连接上限。
#   Session pooler / 直连（5432）由多实例叠加后极易耗尽连接 → 全站间歇性无响应。
#   追加 ?pgbouncer=true 关闭服务端 prepared statement（事务池不支持）。
#   postgresql://postgres.项目ref:密码@aws-0-区域.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# ★ DIRECT_URL（可选）：仅当需要独立直连串跑迁移时配置。
#   Prisma CLI 做 DDL（db push）时优先用它；未配置时自动把 DATABASE_URL 的
#   6543 降级为 5432（Supavisor Session pooler 可跑 DDL），无需额外维护。
# 注意：密码中的特殊字符需要 URL 编码（如 @ 写为 %40）
DATABASE_URL=postgresql://user:password@host:6543/dbname?pgbouncer=true

# ===== JWT 密钥（必填）=====
# 后台登录 Token 签名密钥，至少 32 字符，生产环境务必使用强随机值
# 生成示例：openssl rand -hex 32
SECRET_KEY=your-secret-key-at-least-32-characters

# ===== CNB 图床（建议配置；也可在后台「站点配置」中填写，数据库值优先）=====
# 图片访问统一走博客自带代理 /api/img-proxy/，无需配置图床域名
# CNB 仓库 slug，如 your-name/imgs
CNB_SLUG=your-cnb-slug
# CNB API Token（需有仓库读写权限，https://api.cnb.cool 用户设置里创建）
CNB_TOKEN=your_cnb_api_token
